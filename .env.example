# Copy to .env and fill in.
DATABASE_URL=sqlite:///./qc.db
# DATABASE_URL=postgresql+psycopg://qc:qc@localhost:5432/qc

# false = no login screen; the page has an "Acting as" role dropdown (testing only - anyone can act as approver)
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
STORAGE_DIR=./storage
# Largest photo accepted (MB) and largest image size in pixels (protects against "decompression bomb" images)
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000

# AI provider: "mock" (no AI, everything visual goes to Manual Review) or "claude"
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Seconds per AI call before the check goes to Manual Review, and SDK retries on network errors / 429 / 5xx
AI_TIMEOUT_S=60
AI_MAX_RETRIES=2
AI_CONFIDENCE_THRESHOLD=0.80
# BRD section 10: false = AI Pass/Fail is only a suggestion for QC (Manual Review).
# Set true only after the pilot has validated AI results against real garment inspections.
AI_AUTO_DECIDE=false

# Color check: max allowed Delta-E (CIE76) between garment and PPS reference
COLOR_DELTA_E_MAX=3.0

# LiveKit video call (https://livekit.io) - leave blank to disable token issuing
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Create demo users and a demo PO on first start (turn off in production)
SEED_DEMO_DATA=true
